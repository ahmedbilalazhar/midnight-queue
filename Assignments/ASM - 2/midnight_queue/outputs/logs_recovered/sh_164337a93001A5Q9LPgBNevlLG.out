    import time; from midnight_queue.config import CONFIG, DEFAULT_DATA_PATH; from midnight_queue.data import load_dataset, sample_records; from midnight_queue.conditions import build_conditions; from midnight_queue.records import Counters,TriageOrder,OrderMode,is_sorted,bands_non_increasing; from midnight_queue.sorting import SORT_ALGORITHMS; from midnight_queue.reference import reference_triage, reference_band_stable; ds=load_dataset(DEFAULT_DATA_PATH,verify_checksum=False); s=sample_records(ds.records,1000,CONFIG.seed); cs=build_conditions(s,CONFIG.seed); print('built conditions');\nfor cid,c in cs.items():\n    ref=reference_triage(c.records) if c.order_mode=='triage' else reference_band_stable(c.records)\n    for name,alg in SORT_ALGORITHMS.items():\n        ct=Counters(); t=time.perf_counter(); out=alg(list(c.records),TriageOrder(c.order_mode,ct),ct); dt=time.perf_counter()-t\n        if c.order_mode=='triage': ok=(out==ref and is_sorted(out,TriageOrder()))\n        else: ok=(bands_non_increasing(out) and sorted(t.txn_id for t in out)==sorted(t.txn_id for t in c.records))\n        print(cid,name,'OK' if ok else 'FAIL',round(dt,4),ct.comparisons,ct.moves)\n
